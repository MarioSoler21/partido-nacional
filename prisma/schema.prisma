generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Proyecto {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  titulo      String
  descripcion String
  cuerpo      String   @db.Text
  categoria   String
  imagen      String
  galeria     String[]
  videoUrl    String?
  publicado   Boolean  @default(false)
  creadoEn    DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Noticia {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  titulo    String
  resumen   String
  cuerpo    String   @db.Text
  imagen    String
  tags      String[]
  publicado Boolean  @default(false)
  creadoEn  DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Foto {
  id     Int     @id @default(autoincrement())
  url    String
  album  String
  titulo String?
  orden  Int     @default(0)
}

model Documento {
  id        Int      @id @default(autoincrement())
  nombre    String
  url       String
  categoria String
  creadoEn  DateTime @default(now())
}

model Configuracion {
  id    Int    @id @default(autoincrement())
  clave String @unique
  valor String @db.Text
}
